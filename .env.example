# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=votre-token-ici

# Salon où poster les alertes de température (0 = désactivé)
TEMP_LOG_CHANNEL_ID=0

# Seuil critique de température CPU (°C) et fréquence de vérification (minutes)
TEMP_CRITICAL_THRESHOLD=80
TEMP_CHECK_MINUTES=10

# Répertoire des piles Docker Compose
STACKS_DIR=/opt/stacks

# Points de montage surveillés (séparés par des virgules)
DISKS=/,/mnt/multimedia

# IDs Discord autorisés à piloter les services, séparés par des virgules
# (vide = tout le monde peut utiliser les commandes)
ALLOWED_USER_IDS=
