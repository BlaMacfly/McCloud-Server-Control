# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=votre-token-ici

# Webhook Discord pour les alertes de température (prioritaire sur le salon)
TEMP_WEBHOOK_URL=

# Salon où poster les alertes de température si pas de webhook (0 = désactivé)
TEMP_LOG_CHANNEL_ID=0

# Seuil critique de température CPU (°C) et fréquence de vérification (minutes)
TEMP_CRITICAL_THRESHOLD=80
TEMP_CHECK_MINUTES=10

# Répertoire des serveurs de jeux (un sous-dossier par jeu, avec un start.sh)
GAME_SERVERS_DIR=/home/blamacfly/Bureau/GameServers

# Points de montage surveillés (séparés par des virgules)
DISKS=/,/mnt/multimedia

# IDs Discord autorisés à piloter les serveurs, séparés par des virgules
# (vide = tout le monde peut utiliser les commandes)
ALLOWED_USER_IDS=
